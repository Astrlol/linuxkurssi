[Unit]
Description=Kävijälaskuri
After=network.target mysql.service
Requires=mysql.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/linuxkurssi
EnvironmentFile=/etc/laskuri.env
ExecStart=/home/ubuntu/linuxkurssi/venv/bin/gunicorn -b 127.0.0.1:5000 laskuri:app
Restart=always

[Install]
WantedBy=multi-user.target