[Unit]
Description=Viikko 4: read-only replikasivu
After=network.target mysql.service
Wants=mysql.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/linuxkurssi/viikko4
EnvironmentFile=/etc/viikko4.env
ExecStart=/home/ubuntu/linuxkurssi/venv/bin/gunicorn -b 127.0.0.1:5001 kopiolaskuri:app
Restart=always

[Install]
WantedBy=multi-user.target
